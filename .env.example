# Backend (set these on RunPod)
ECHOMIMIC_MODEL_DIR=/workspace/models
TEMP_DIR=/tmp/stillalive
HOST=0.0.0.0
PORT=8000

# Storage: local (default) or s3 (works with AWS S3 and Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PREFIX=stillalive
STORAGE_PRESIGN_EXPIRY_SECONDS=3600

# Frontend
NEXT_PUBLIC_API_URL=https://your-pod-id-8000.proxy.runpod.net
